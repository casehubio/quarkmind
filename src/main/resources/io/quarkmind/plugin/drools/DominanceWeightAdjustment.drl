// --- PHASE MODIFIERS ---

rule "Phase: DEFENSIVE_HOLD"
when
    /tacticalPostureStore[this == "DEFENSIVE_HOLD"]
then
    modifiers.add(new WeightModifier(-0.10, +0.15, -0.05, 0.00,
        "Phase: DEFENSIVE_HOLD"));
end

rule "Phase: EARLY_AGGRESSION"
when
